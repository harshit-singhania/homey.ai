# App
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# Transport (mock or telegram)
TRANSPORT=telegram

# Telegram (when TRANSPORT=telegram)
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=  # Optional, for webhook mode
TELEGRAM_WEBHOOK_SECRET=  # Optional, for webhook validation

# Gemini
GEMINI_API_KEY=put-your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=postgresql://homey:homey@localhost:5433/homeyai

# Redis (for task queue / caching)
REDIS_URL=redis://redis:6379

# Media Storage (S3/R2 compatible)
STORAGE_TYPE=local
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
